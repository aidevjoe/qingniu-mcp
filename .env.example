# ===== 轻牛健康账号（仅用于本地 MD5 + 登录，凭证不离开运行本服务的机器）=====
# 手机号：轻牛/云麦 App 登录用的手机号
QN_PHONE=your_app_phone_number
# 密码：App 登录密码（非短信验证码）。若平时只用扫码登录，请先在 App 里设置一个密码。
QN_PASSWORD=your_app_password

# ===== MCP 服务监听（容器内）=====
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8801

# ===== 可选：token 持久化（容器内路径，配合 ./state 挂载）=====
QN_TOKEN_FILE=/app/state/token.json
# token 有效期（天），到期自动重新登录。默认 30 天。
QN_TOKEN_TTL_DAYS=30

# ===== 可选：给 MCP 端点加 Bearer 鉴权（公网/反代暴露时建议启用）=====
# 启用后，客户端连接需带 Authorization: Bearer <下方的值>
# MCP_AUTH_TOKEN=change_me_strong_token